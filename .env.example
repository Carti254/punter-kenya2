# Required to run the Telegram bot
BOT_TOKEN=replace_with_your_telegram_bot_token

# Free-tier Gemini AI for natural-language requests and betting-slip image reading.
# Add the secret privately in Railway Variables; never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional GOAL API supplementary team-results/statistics source.
GOAL_API_BASE=
GOAL_API_KEY=

# Optional API-Sports / API-Football statistics (corners, cards, halftime, player figures).
API_FOOTBALL_KEY=

# Optional MySQL-compatible database.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
