# Required to run the Telegram bot
BOT_TOKEN=replace_with_your_telegram_bot_token

# Optional GOAL API supplementary team-results/statistics source.
# Use the base URL and API key supplied by the existing GOAL API account.
GOAL_API_BASE=
GOAL_API_KEY=

# Optional API-Sports / API-Football statistics (corners, cards, halftime, player figures).
# Free plan is limited; check competition coverage and quota before relying on settlement.
API_FOOTBALL_KEY=

# Optional MySQL-compatible database.
# Without these values, the bot starts in local/basic mode.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
